<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#101827">
<title>Meu IP — Laboratório pessoal</title>
<style>
*{box-sizing:border-box}
body{margin:0;min-height:100vh;display:grid;place-items:center;padding:22px;background:#101827;color:#f4f7fb;font-family:system-ui,-apple-system,Segoe UI,sans-serif}
main{width:min(100%,440px);padding:26px 22px;border-radius:22px;background:#1c293b;border:1px solid #34445b;text-align:center;box-shadow:0 18px 50px #0003}
.tag{color:#91a7c5;font-size:12px;letter-spacing:.14em;text-transform:uppercase}
h1{margin:9px 0 8px;font-size:27px}
.intro{color:#b9c7d9;line-height:1.5;margin:0 0 20px}
.ip{margin:18px 0;padding:17px 10px;border-radius:13px;background:#101827;font-size:clamp(24px,7vw,31px);font-weight:750;overflow-wrap:anywhere}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;text-align:left}
.item{min-width:0;padding:12px;border-radius:12px;background:#142033;border:1px solid #2c3d54}
.item.wide{grid-column:1/-1}
.key{display:block;color:#91a7c5;font-size:11px;text-transform:uppercase;letter-spacing:.07em;margin-bottom:5px}
.val{display:block;color:#f4f7fb;font-size:15px;font-weight:600;overflow-wrap:anywhere}
button{margin-top:20px;border:0;border-radius:11px;padding:13px 18px;background:#4c8dff;color:white;font-size:16px;font-weight:700;width:100%}
button:disabled{opacity:.6}
#status{min-height:22px;color:#b9c7d9;font-size:13px;margin:12px 0 0}
.note{margin:18px 2px 0;color:#91a7c5;font-size:11px;line-height:1.45}
</style>
</head>
<body>
<main>
  <div class="tag">Laboratório pessoal</div>
  <h1>Meu endereço IP</h1>
  <p class="intro">Veja informações aproximadas da conexão que está usando agora.</p>
  <div class="ip" id="ip">Carregando…</div>
  <section class="grid" aria-live="polite">
    <div class="item"><span class="key">Cidade estimada</span><span class="val" id="city">—</span></div>
    <div class="item"><span class="key">Estado / região</span><span class="val" id="region">—</span></div>
    <div class="item"><span class="key">País</span><span class="val" id="country">—</span></div>
    <div class="item"><span class="key">CEP estimado</span><span class="val" id="postal">—</span></div>
    <div class="item wide"><span class="key">Provedor / organização</span><span class="val" id="org">—</span></div>
    <div class="item wide"><span class="key">Fuso horário</span><span class="val" id="timezone">—</span></div>
    <div class="item wide"><span class="key">ASN da rede</span><span class="val" id="asn">—</span></div>
  </section>
  <button id="refresh" type="button">Atualizar informações</button>
  <p id="status" role="status">Consultando serviço externo…</p>
  <p class="note">Laboratório educativo. Os dados de cidade e CEP são estimativas baseadas no IP e podem estar incorretos. O serviço externo consultado recebe sua solicitação e pode registrar o IP.</p>
</main>
<script>
const fields = ["ip","city","region","country","postal","org","timezone","asn"];
const put = (id, value) => document.getElementById(id).textContent = value || "Não informado";
async function loadInfo(){
  const button=document.getElementById("refresh");
  const status=document.getElementById("status");
  button.disabled=true; button.textContent="Consultando…";
  status.textContent="Buscando informações da conexão…";
  fields.forEach(id=>put(id,"—"));
  try{
    const response=await fetch("https://ipapi.co/json/",{cache:"no-store"});
    if(!response.ok) throw new Error("Serviço indisponível");
    const d=await response.json();
    if(d.error) throw new Error(d.reason || "Não foi possível consultar");
    put("ip",d.ip);
    put("city",d.city);
    put("region",d.region);
    put("country",d.country_name ? `${d.country_name} (${d.country})` : d.country);
    put("postal",d.postal);
    put("org",d.org);
    put("timezone",d.timezone);
    put("asn",d.asn);
    status.textContent="Consulta concluída.";
  }catch(e){
    put("ip","Não foi possível consultar");
    status.textContent="Falha na consulta. Verifique a internet e tente novamente.";
  }finally{
    button.disabled=false; button.textContent="Atualizar informações";
  }
}
document.getElementById("refresh").addEventListener("click",loadInfo);
loadInfo();
</script>
</body>
</html>
